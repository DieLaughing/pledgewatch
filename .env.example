# Pledge Watch settings (no comments after a value: Docker would read them as part of it). Copy to settings.env (never commit it) and pass it to the container with env_file.
# Leave a platform's TOKEN empty to run without it. The website works with no bot at all.

# Discord (https://discord.com/developers/applications → your app)
# Bot page → Reset Token
DISCORD_TOKEN=
# General Information → Application ID (used for the site's "Add to Discord" link)
DISCORD_APP_ID=
# optional: your own server, set up without /alerts setup and never counted in the cap
DISCORD_GUILD_ID=
# optional: alert channel in that server
DISCORD_CHANNEL_ID=
# optional: role to ping there when a ship comes in
DISCORD_ROLE_ID=

# Fluxer (one community; Fluxer bots can't register slash commands yet, so it uses !watch etc.)
FLUXER_TOKEN=
FLUXER_API=https://your-fluxer-instance.example
FLUXER_GUILD_ID=
FLUXER_CHANNEL_ID=
FLUXER_ROLE_ID=

# Optional
# seconds between store checks
PW_INTERVAL=300
# website port inside the container
PW_PORT=8794
# Discord servers the bot stays in besides yours (unverified bots stop at 100)
PW_MAX_SERVERS=75
